#!/usr/bin/env bash

set -euo pipefail

if [[ $# -gt 1 ]]; then
    echo "Verwendung: $0 [YYYY-MM-DD [HH:MM:SS]]" >&2
    exit 1
fi

if [[ $# -eq 1 ]]; then
    datum="$1"
else
    datum="$(date '+%F %T')"
fi

# ------------------------------------------------------------
# Datum/Zeit prüfen
# ------------------------------------------------------------

if ! zeitpunkt="$(date -d "$datum" '+%s' 2>/dev/null)"; then
    echo "Ungültiges Datum/Zeit: $datum" >&2
    echo "Erwartetes Format: YYYY-MM-DD HH:MM:SS" >&2
    exit 1
fi

# Normalisierte Darstellung erzeugen.
normalisiert="$(date -d "@$zeitpunkt" '+%F %T')"

# ------------------------------------------------------------
# Jahr bestimmen
# ------------------------------------------------------------

jahr="$(date -d "@$zeitpunkt" '+%Y')"
jahr_num=$((10#$jahr))

# ------------------------------------------------------------
# Jahresgrenzen bestimmen
# ------------------------------------------------------------

jahresbeginn="$(date -d "$jahr-01-01 00:00:00" '+%s')"

naechstes_jahr=$((jahr_num + 1))

jahresende="$(date -d "$naechstes_jahr-01-01 00:00:00" '+%s')"

# ------------------------------------------------------------
# Zeit innerhalb des Jahres
# ------------------------------------------------------------

jahreslaenge=$((jahresende - jahresbeginn))

vergangen=$((zeitpunkt - jahresbeginn))

# ------------------------------------------------------------
# Stardate berechnen
#
# TNG / DS9 / Voyager
#
# 2364-01-01 00:00:00 -> 41000.0000
#
# 1000 Stardate-Einheiten pro Kalenderjahr.
#
# Wir berechnen auf 4 Nachkommastellen.
# Daher:
#
# 1000 * 10000 = 10.000.000
#
# Stardate-Einheiten pro Jahr.
# ------------------------------------------------------------

basis=$((41000 + (jahr_num - 2364) * 1000))

zaehler=$((vergangen * 10000000))

# Rundung auf 4 Nachkommastellen
zaehler=$((zaehler + jahreslaenge / 2))

fortschritt=$((zaehler / jahreslaenge))

# ------------------------------------------------------------
# Ganze Stardate und Nachkommastellen trennen
# ------------------------------------------------------------

stardate_ganz=$((basis + fortschritt / 10000))

stardate_dezimal=$((fortschritt % 10000))

# ------------------------------------------------------------
# Ausgabe
# ------------------------------------------------------------

printf 'Datum:    %s\n' "$normalisiert"
printf 'Stardate: %d.%04d\n' "$stardate_ganz" "$stardate_dezimal"
