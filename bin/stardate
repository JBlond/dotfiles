#!/usr/bin/env bash

set -euo pipefail

# ------------------------------------------------------------
# Star Trek Stardate Calculator
#
# TNG / DS9 / Voyager
#
# Referenz:
#   2364-01-01 00:00:00 UTC = Stardate 41000.0000
#
# Die Stardate steigt um 1000 Einheiten pro Kalenderjahr.
#
# Alle Zeitangaben werden als UTC behandelt.
# ------------------------------------------------------------

if [[ $# -gt 1 ]]; then
    echo "Verwendung: $0 [YYYY-MM-DD[ HH:MM:SS]]" >&2
    exit 1
fi

# ------------------------------------------------------------
# Eingabe
# ------------------------------------------------------------

if [[ $# -eq 1 ]]; then
    eingabe="$1"
else
    eingabe="$(TZ=UTC date '+%Y-%m-%d %H:%M:%S')"
fi

# ------------------------------------------------------------
# Datum/Zeit prüfen und in Unix-Zeit umwandeln
# ------------------------------------------------------------

if ! zeitpunkt="$(TZ=UTC date -d "$eingabe" '+%s' 2>/dev/null)"; then
    echo "Ungültiges Datum/Zeit: $eingabe" >&2
    echo "Erwartetes Format: YYYY-MM-DD oder YYYY-MM-DD HH:MM:SS" >&2
    exit 1
fi

# Normalisierte UTC-Darstellung
normalisiert="$(TZ=UTC date -d "@$zeitpunkt" '+%Y-%m-%d %H:%M:%S')"

# ------------------------------------------------------------
# Jahr bestimmen
# ------------------------------------------------------------

jahr="$(TZ=UTC date -d "@$zeitpunkt" '+%Y')"
jahr_num=$((10#$jahr))

# ------------------------------------------------------------
# Jahresgrenzen bestimmen
# ------------------------------------------------------------

jahresbeginn="$(TZ=UTC date -d "$jahr-01-01 00:00:00 UTC" '+%s')"

naechstes_jahr=$((jahr_num + 1))

jahresende="$(
    TZ=UTC date \
        -d "$naechstes_jahr-01-01 00:00:00 UTC" \
        '+%s'
)"

# ------------------------------------------------------------
# Zeit innerhalb des Jahres
# ------------------------------------------------------------

jahreslaenge=$((jahresende - jahresbeginn))
vergangen=$((zeitpunkt - jahresbeginn))

# ------------------------------------------------------------
# Stardate berechnen
#
# 2364-01-01 00:00:00 UTC
#     = 41000.0000
#
# 1000 Stardate-Einheiten pro Jahr.
#
# Wir berechnen auf 4 Nachkommastellen.
# ------------------------------------------------------------

basis=$((41000 + (jahr_num - 2364) * 1000))

# 1000 Stardate-Einheiten
# × 10000 für vier Nachkommastellen
# = 10.000.000 Einheiten pro Jahr

zaehler=$((vergangen * 10000000))

# Auf die vierte Nachkommastelle runden
zaehler=$((zaehler + jahreslaenge / 2))

fortschritt=$((zaehler / jahreslaenge))

# ------------------------------------------------------------
# Ganze Stardate und Nachkommastellen trennen
# ------------------------------------------------------------

stardate_ganz=$((basis + fortschritt / 10000))
stardate_dezimal=$((fortschritt % 10000))

# ------------------------------------------------------------
# Ausgabe
# ------------------------------------------------------------

printf 'Datum (UTC): %s\n' "$normalisiert"
printf 'Stardate:    %d.%04d\n' \
    "$stardate_ganz" \
    "$stardate_dezimal"
