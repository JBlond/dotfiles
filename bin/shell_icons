#!/bin/sh
# Translates program names to icons, so we can use them in our tmux config.
# Based on https://github.com/caarlos0/icons

case "$1" in
    ack|fd|find|fzf|grep|rg)
        echo "" ;;
    atop|htop|top)
        echo "" ;;
    bash|fish|zsh)
        echo "" ;;
    bat|cat)
        echo "" ;;
    cp|duplicate)
        echo "" ;;
    mv|mc)
        echo "" ;;
    curl|http|pint|lynx|wget|w3m)
        echo "" ;;
    docker|docker-compose)
        echo "" ;;
    exa|lf|ls|nnn|ranger)
        echo "פּ" ;;
    gh)
        echo "" ;;
    git)
        echo "" ;;
    glow)
        echo "" ;;
    less|more|make)
        echo "" ;;
    lua)
        echo "" ;;
    man)
        echo "" ;;
    node|npm|yarn)
        echo "" ;;
    nvim|vim|vi)
        echo "" ;;
    python|pip)
        echo "" ;;
    rm)
        echo "﫧" ;;
    rsync)
        echo "" ;;
    scp|ssh)
        echo "" ;;
    sleep)
        echo "" ;;
    spin|tail)
        echo "" ;;
    sudo)
        echo "" ;;
    tmux)
        echo "﬿" ;;
    youtube-dl)
        echo "" ;;
esac
